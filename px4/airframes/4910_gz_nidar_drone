#!/bin/sh
#
# @name NIDAR drone (Gazebo)
# @type Quadrotor
# @class Copter
#
# Model made from the team's SolidWorks URDF (nidar_drone_description).
# Start with:  make px4_sitl gz_nidar_drone

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
# NIDAR AirMouse practice arena (Rulebook v2.2, PS2); drone on the 2 ft x 2 ft
# launch area outside the entry, facing into the arena (north).
PX4_GZ_WORLD=${PX4_GZ_WORLD:=nidar_arena}
PX4_GZ_MODEL_POSE=${PX4_GZ_MODEL_POSE:="7.5,-0.5,0.2,0,0,1.5708"}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=nidar_drone}

param set-default SIM_GZ_EN 1

# ---- NO GPS / GNSS (Rulebook v2.2 rule 8.24) ----------------------------------
# Position, velocity, height and heading come ONLY from vision odometry
# (/fmu/in/vehicle_visual_odometry). In simulation nidar_control/ev_bridge fills it;
# on the real drone the SLAM pose goes into the same topic.
param set-default SENS_EN_GPSSIM 0
param set-default SYS_HAS_GPS 0
param set-default EKF2_GPS_CTRL 0
param set-default SENS_EN_BAROSIM 0
param set-default SENS_EN_MAGSIM 0
param set-default SYS_HAS_MAG 0
param set-default EKF2_MAG_TYPE 5
param set-default EKF2_EV_CTRL 15
param set-default EKF2_HGT_REF 3
param set-default EKF2_BARO_CTRL 1
param set-default COM_ARM_WO_GPS 1

# ---- Indoor flight limits (1 m corridors, 2.44 m ceiling) ---------------------
param set-default MPC_XY_VEL_MAX 1.5
param set-default MPC_XY_CRUISE 1.0
param set-default MPC_Z_VEL_MAX_UP 0.8
param set-default MPC_Z_VEL_MAX_DN 0.6
param set-default MPC_TKO_SPEED 0.6
param set-default MPC_LAND_SPEED 0.4
param set-default MPC_ACC_HOR 2.0

# ---- Fail-safes (Rulebook v2.2 rule 8.31 and PS2 section 10) ------------------
# PX4's Return mode needs GPS and flies in straight lines (into walls), so the
# smart reactions (emergency recall along the flown path, geofence, comm loss, low
# battery, mission time limit) live in nidar_control/offboard_control.
# These PX4 settings are the BACKSTOP if that node itself fails:
param set-default COM_OF_LOSS_T 1.0
param set-default COM_OBL_RC_ACT 4
param set-default NAV_DLL_ACT 0
param set-default COM_DL_LOSS_T 5
param set-default BAT_LOW_THR 0.25
param set-default BAT_CRIT_THR 0.12
param set-default BAT_EMERGEN_THR 0.07
param set-default COM_LOW_BAT_ACT 2
# simulated battery: drains over the 30-min maximum flight time
param set-default SIM_BAT_DRAIN 1800
param set-default SIM_BAT_MIN_PCT 5

# ---- Control allocation: 4 rotors, positions in metres from the centre of
# mass (CoM is 11 mm behind the motor centre, from the CAD), FRD frame
# (x forward, y RIGHT). KM > 0 = counter-clockwise prop.
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.133
param set-default CA_ROTOR0_PY 0.140
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX -0.111
param set-default CA_ROTOR1_PY -0.140
param set-default CA_ROTOR1_KM 0.05

param set-default CA_ROTOR2_PX 0.133
param set-default CA_ROTOR2_PY -0.140
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.111
param set-default CA_ROTOR3_PY 0.140
param set-default CA_ROTOR3_KM -0.05

# ---- Simulated ESCs: PX4 output 1..4 -> Gazebo motor 0..3 (rad/s range)
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150
param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000

# ---- Roll-rate gains for THIS CAD model (found with tools/pid_analyze.py).
# The CAD has no arms, so roll inertia Ixx = 0.0048 kg m^2 vs pitch Iyy = 0.0217,
# and the roll lever arm is 0.14 m vs 0.22 m on the x500 these defaults were made
# for. With PX4 defaults (P 0.15, I 0.2, D 0.003) roll oscillated (99 deg/s RMS
# rate error in flight); with these: 8 deg/s. Scaled by 1/2.9. RE-TUNE when the CAD gets
# arms + battery.
param set-default MC_ROLLRATE_P 0.05
param set-default MC_ROLLRATE_I 0.07
param set-default MC_ROLLRATE_D 0.001

# 1.42 kg, 4 x 8.55 N max thrust -> hover at about 57 % output
param set-default MPC_THR_HOVER 0.57
