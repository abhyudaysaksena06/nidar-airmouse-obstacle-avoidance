Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic: 
        Value: /robot_description
      Visual Enabled: true
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.15
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar /scan
      Enabled: true
      Topic: 
        Value: /scan
        Reliability Policy: Best Effort
        Depth: 5
      Color Transformer: FlatColor
      Color: "255; 50; 50"
      Size (m): 0.04
      Style: Spheres
    - Class: rviz_default_plugins/PointCloud2
      Name: ToF /tof_front/points
      Enabled: true
      Topic: 
        Value: /tof_front/points
        Reliability Policy: Best Effort
        Depth: 5
      Color Transformer: FlatColor
      Color: "0; 255; 255"
      Size (m): 0.03
      Style: Spheres
    - Class: rviz_default_plugins/LaserScan
      Name: Ultrasonic 1
      Enabled: true
      Topic: 
        Value: /ultrasonic_1
        Reliability Policy: Best Effort
        Depth: 5
      Color Transformer: FlatColor
      Color: "255; 255; 0"
      Size (m): 0.03
      Style: Spheres
    - Class: rviz_default_plugins/LaserScan
      Name: Ultrasonic 2
      Enabled: true
      Topic: 
        Value: /ultrasonic_2
        Reliability Policy: Best Effort
        Depth: 5
      Color Transformer: FlatColor
      Color: "255; 255; 0"
      Size (m): 0.03
      Style: Spheres
    - Class: rviz_default_plugins/LaserScan
      Name: Ultrasonic 3
      Enabled: true
      Topic: 
        Value: /ultrasonic_3
        Reliability Policy: Best Effort
        Depth: 5
      Color Transformer: FlatColor
      Color: "255; 255; 0"
      Size (m): 0.03
      Style: Spheres
    - Class: rviz_default_plugins/LaserScan
      Name: Ultrasonic 4
      Enabled: true
      Topic: 
        Value: /ultrasonic_4
        Reliability Policy: Best Effort
        Depth: 5
      Color Transformer: FlatColor
      Color: "255; 255; 0"
      Size (m): 0.03
      Style: Spheres
    - Class: rviz_default_plugins/Image
      Name: Down camera
      Enabled: true
      Topic: 
        Value: /camera/image_raw
        Reliability Policy: Best Effort
        Depth: 5
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point: {X: 0, Y: 0, Z: 0.05}
      Pitch: 0.45
      Yaw: 0.8
      Target Frame: base_link
Window Geometry:
  Width: 1400
  Height: 900
