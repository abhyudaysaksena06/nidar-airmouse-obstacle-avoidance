<?xml version="1.0"?>
<package format="3">
  <name>nidar_control</name>
  <version>1.0.0</version>
  <description>NIDAR controls: PX4 offboard mission node and PID setpoint-vs-actual logger.</description>
  <maintainer email="nidar-controls@example.com">NIDAR Controls</maintainer>
  <license>BSD-3-Clause</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
